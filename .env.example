# Copie este arquivo para ".env" (na mesma pasta) e preencha. O .env NUNCA vai para o git (está no .gitignore).
# Na Vercel, as mesmas variáveis vão em Project → Settings → Environment Variables.

# Supabase → Project Settings → API (ou "Connect"): URL do projeto e a chave pública "anon".
# A anon é a ÚNICA chave que a tela recebe (para o login). Nunca use aqui a "service_role".
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-aqui-a-chave-anon

# Conexão do servidor com o banco (segredo: só o backend usa).
# Supabase → Connect → Direct → "Transaction pooler" (porta 6543). Copie a string de lá (o servidor, aws-0 ou
# aws-1, muda de projeto para projeto) e troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA-DO-BANCO@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Só para o script de migração (scripts/migrar_para_supabase.py): Connect → Direct → "Session pooler" (porta 5432).
MIGRACAO_DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA-DO-BANCO@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Opcional: chave pública do DataJud (sem ela, vale a do config.json ou a salva em Configurações)
# DATAJUD_API_KEY=
